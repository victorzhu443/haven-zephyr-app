/*
 * Haven copy of the OpenEarable 2.0 board definition (OpenEarable/open-earable-2,
 * boards/teco/openearable_v2). Haven's board is a port of this exact PCB, so
 * the pin map is the same. Local changes are marked "Haven:" -- the codec node
 * moved to &i2c2 (see comment there), I2S MCK dropped from the pinctrl (the
 * codec has no MCLK input; upstream's MCK pin P1.14 doubles as its
 * alternative PDM clock pin), and the UART GPIO forwarder removed (no
 * net-core UART here).
 */
 #include "openearable_v2_nrf5340_cpuapp_common-pinctrl.dtsi"
 #include <zephyr/dt-bindings/input/input-event-codes.h>
 
 / {
	 chosen {
		 zephyr,console = &uart0;
		 zephyr,shell-uart = &uart0;
		 zephyr,uart-mcumgr = &cdc_acm_uart0;
		 zephyr,bt-mon-uart = &uart0;
		 zephyr,bt-c2h-uart = &uart0;
		 zephyr,bt-hci = &bt_hci_ipc0;
		 watchdog0 = &wdt0;
	 };
 
 
	 sd_state: sd_state {
		 compatible = "power-switch";
		 gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	 };
 
	 load_switch: load_switch {
		 compatible = "load-switch";
		 enable-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		 power-delay-us = <300>; // 250us per datasheet
		 status = "okay";
		 default-on;
	 };
 
	 load_switch_sd: load_switch_sd {
		 compatible = "load-switch";
		 enable-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		 power-delay-us = <300>; // 250us per datasheet
		 status = "okay";
	 };
 
 };
 
 &clock {
	 hfclkaudio-frequency = <12288000>;
 };

 // Oscillator Parameters 32mHz / 8pF / 20ppm
 &hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <8000>;
 };

 &lfxo {
	load-capacitors = "external";
  };
 
 &adc {
	 status = "okay";
 };
 
 &gpiote {
	 status = "okay";
 };
 
 &gpio0 {
	 status = "okay";
 };
 
 &gpio1 {
	 status = "okay";
 };
 
 &i2s0 {
	 compatible = "nordic,nrf-i2s";
	 status = "okay";
	 pinctrl-0 = <&i2s0_default>;
	 pinctrl-1 = <&i2s0_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 dmic_dev: &pdm0 {
	 compatible = "nordic,nrf-pdm";
	 status = "disabled";
	 pinctrl-0 = <&pdm0_default_alt>;
	 pinctrl-names = "default";
	 clock-source = "ACLK";
 };
 
 &i2c1 {
	 compatible = "nordic,nrf-twim";
	 status = "okay";
	 pinctrl-0 = <&i2c1_default>;
	 pinctrl-1 = <&i2c1_sleep>;
	 pinctrl-names = "default", "sleep";
	 clock-frequency = <I2C_BITRATE_FAST>;  // 400 kHz
	 zephyr,concat-buf-size = <512>;
     zephyr,flash-buf-max-size = <512>;
 
	 bq27220: bq27220@55 {
		 compatible = "ti,bq27220";
		 reg = <0x55>;
		 gpout-gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	 };
 
	 bq25120a: bq25120a@6a {
		 compatible = "ti,bq25120a";
		 reg = <0x6a>;
		 int-gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		 cd-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		 pg-gpios = <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		load-switch {
			compatible = "load-switch";
			enable-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			power-delay-us = <600>; // 250us per datasheet
			status = "okay";
        };
	 };
 
 };
 
 &i2c2 {
	 compatible = "nordic,nrf-twim";
	 status = "okay";
	 pinctrl-0 = <&i2c2_default>;
	 pinctrl-1 = <&i2c2_sleep>;
	 pinctrl-names = "default", "sleep";
	 clock-frequency = <I2C_BITRATE_FAST>;  // 400 kHz
	 zephyr,concat-buf-size = <512>;
     zephyr,flash-buf-max-size = <512>;

	maxm86161: maxm86161@62 {
        compatible = "i2c-device";
        reg = <0x62>;
    };

	mlx90632: mlx90632@3A {
        compatible = "i2c-device";
        reg = <0x3A>;
    };

	/* ADAU1860 codec/DSP. Upstream OpenEarable declares this node under
	 * &i2c1 but talks to it through its `I2C2` TWIM wrapper (src/Wire/TWIM.cpp:
	 * `TWIM I2C2(DEVICE_DT_GET(DT_NODELABEL(i2c2)))`, `ADAU1860 dac(&I2C2)`),
	 * i.e. the bus on P1.00 (SCL) / P1.15 (SDA) -- which is also where the
	 * Haven board netlist puts the codec's SCL1/SDA1 pins (MDBT53 pins 45/47).
	 * Haven's driver uses the node's parent bus for real, so the node lives
	 * on the bus the wires go to.
	 */
	adau1860: adau1860@64 {
		compatible = "analog,adau1860";
		reg = <0x64>;
		enable-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;  /* net DAC_ENABLE -> codec pin E4 */
	};
 };
 
 &i2c3 {
	 compatible = "nordic,nrf-twim";
	 status = "okay";
	 pinctrl-0 = <&i2c3_default>;
	 pinctrl-1 = <&i2c3_sleep>;
	 pinctrl-names = "default", "sleep";
	 clock-frequency = <I2C_BITRATE_FAST_PLUS>;  // 1000 kHz
	 zephyr,concat-buf-size = <512>;
     zephyr,flash-buf-max-size = <512>;

	bmp388: bmp388@76 {
        compatible = "i2c-device";
        reg = <0x76>;
    };

	bma580: bma580@18 {
        compatible = "i2c-device";
        reg = <0x18>;
    };

	bmx160: bmx160@68 {
        compatible = "i2c-device";
        reg = <0x68>;
    };
 };
 
 &uart0 {
	 status = "okay";
	 current-speed = <115200>;
	 pinctrl-0 = <&uart0_default>;
	 pinctrl-1 = <&uart0_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &uart1 {
	 compatible = "nordic,nrf-uarte";
	 current-speed = <115200>;
	 pinctrl-0 = <&uart1_default>;
	 pinctrl-1 = <&uart1_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &pwm0 {
	 status = "disabled"; // okay
	 pinctrl-0 = <&pwm0_default>;
	 pinctrl-1 = <&pwm0_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &qspi {
	 status = "disabled";
	 pinctrl-0 = <&qspi_default>;
	 pinctrl-1 = <&qspi_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &spi2 {
	 compatible = "nordic,nrf-spim";
	 status = "disabled";
	 cs-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
 
	 pinctrl-0 = <&spi2_default>;
	 pinctrl-1 = <&spi2_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &spi3 {
	 compatible = "nordic,nrf-spim";
	 status = "disabled";
	 cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
 
	 pinctrl-0 = <&spi3_default>;
	 pinctrl-1 = <&spi3_sleep>;
	 pinctrl-names = "default", "sleep";
 };
 
 &spi4 {
	 compatible = "nordic,nrf-spim";
	 status = "okay";
	 cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>,<&gpio1 1 GPIO_ACTIVE_LOW>;
 
	 pinctrl-0 = <&spi4_default>;
	 pinctrl-1 = <&spi4_sleep>;
	 pinctrl-names = "default", "sleep";
	 sdhc0: sdhc@0 {
		 compatible = "zephyr,sdhc-spi-slot";
		 reg = <0>;
		 status = "okay";
		 sdmmc {
			 compatible = "zephyr,sdmmc-disk";
			 status = "okay";
			 disk-name = "SD";
		 };
 
		 spi-max-frequency = <32000000>;
	 };
 };
 
 zephyr_udc0: &usbd {
	 compatible = "nordic,nrf-usbd";
	 status = "okay";
	 cdc_acm_uart0: cdc_acm_uart0 {
		 compatible = "zephyr,cdc-acm-uart";
	 };
 };
 
 &uicr {
	 nfct-pins-as-gpios;
 };
 
 /* Include partition configuration file */
 //#include "openearable_v2_nrf5340_cpuapp_partition_conf.dts"
 /* NCS v3.4: the nRF5340 partition layouts moved from <common/nordic/...>
  * to <nordic/...> (see zephyr boards/nordic/nrf5340dk). */
 #include <nordic/nrf5340_cpuapp_partition.dtsi>
 #include "openearable_v2_nrf5340_shared.dtsi"
 