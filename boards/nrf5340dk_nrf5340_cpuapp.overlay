/*
 * nRF5340 DK bench wiring for an ADAU1860 (e.g. EVAL-ADAU1860EBZ) —
 * application core.
 *
 * Control port : I2C1 (Arduino-header SDA/SCL on the DK; ADAU1860 at 0x64)
 * Enable pin   : Arduino D2 = P1.04 → the codec's PD/enable (net DAC_ENABLE
 *                on the real board). Must be driven before any I2C traffic;
 *                adau1860_control.c does that.
 * Audio data   : I2S0, nRF5340 as MASTER — carries only the LDL calibration
 *                tone (tone_gen.c, 48 kHz 16-bit stereo). The hear-through
 *                path is mic → FastDSP → DAC entirely inside the codec.
 *
 * This DK is only a bench for the codec's control plane. The real target is
 * boards/teco/openearable_v2 (the OpenEarable 2.0 / Haven board), where the
 * codec sits on the P1.00/P1.15 bus and is enabled by P0.04.
 *
 * NOTE: confirm i2c1 is the Arduino-header bus and P1.04 is D2 for your
 * exact NCS version / DK revision before wiring — Nordic DK pin maps have
 * shifted between releases (see the DK's own arduino_header node).
 *
 * NOTE (history): an earlier revision of this overlay put the nRF5340 as
 * I2S *slave*, inferring that from the codec's own 24.576 MHz crystal. The
 * upstream OpenEarable firmware that runs on this codec has the nRF as I2S
 * MASTER (I2S_SCK_M / I2S_LRCK_M, hfclkaudio 12.288 MHz); the ADAU1860
 * bridges the two clock domains with its ASRCs, which is what they are for.
 * The upstream pinout also settles signal direction: nRF SDOUT → codec
 * SDATAI_0 (board net "DIN"), codec SDATAO_0 → nRF SDIN (net "DOUT").
 */

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	adau1860: adau1860@64 {
		compatible = "analog,adau1860";
		reg = <0x64>;
		enable-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/*
 * The DK's board-level pinctrl has no i2s0 state at all — I2S isn't part of
 * the DK's standard Arduino-header mapping the way i2c1 is — so it's defined
 * here, on Arduino D4–D7 (gpio1 6–9), which are otherwise unused by the
 * DK's leds/buttons/i2c1/uart0/uart1/qspi/spi4. No MCK: the ADAU1860 runs
 * from its own crystal and has no MCLK input wired on the real board.
 */
&pinctrl {
	i2s0_default: i2s0_default {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 6)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 7)>,
				<NRF_PSEL(I2S_SDOUT, 1, 8)>,
				<NRF_PSEL(I2S_SDIN, 1, 9)>;
		};
	};

	i2s0_sleep: i2s0_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 6)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 7)>,
				<NRF_PSEL(I2S_SDOUT, 1, 8)>,
				<NRF_PSEL(I2S_SDIN, 1, 9)>;
			low-power-enable;
		};
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-1 = <&i2s0_sleep>;
	pinctrl-names = "default", "sleep";
	/* 12.288 MHz audio PLL -> exact 48 kHz frame clock for the LDL tone
	 * (tone_gen.c). Wire D4 (BCLK) / D5 (LRCLK) / D6 (SDOUT) to the eval
	 * board's P2 header: pins 8 / 6 / 4 respectively (UG-2017 Table 8). */
	clock-source = "ACLK";
};

&clock {
	hfclkaudio-frequency = <12288000>;
};
