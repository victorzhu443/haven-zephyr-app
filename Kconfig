mainmenu "Haven nRF5340 firmware"

menu "Haven"

config HAVEN_FDSP_RATE_HZ
	int "FastDSP frame rate the biquad coefficients are designed for (Hz)"
	default 192000
	help
	  Must equal the ADAU1860 FastDSP frame-rate source selected by
	  FDSP_CTRL4 (upstream OpenEarable: DMIC01 at 192 kHz). If a notch
	  commanded at f0 lands at f0/4 on hardware, this is what's wrong.
	  Q5.27 precision at 192 kHz is adequate for every band the protocol
	  allows (worst pure notch still >= 48.9 dB deep, centre error
	  <= 0.2 cents, all designs stable) -- see
	  tools/dsp/results/notch_quantisation.md. docs/fastdsp-program.md
	  has the evidence for the 192 kHz figure itself.

config HAVEN_FDSP_BANK
	int "FastDSP parameter bank to run (0 normal / 1 transparency / 2 ANC)"
	range 0 2
	default 1
	help
	  Upstream's three banks double as audio modes. Bank 0 zeroes the five
	  biquads (mic path silent); bank 1 is the hear-through path Haven's
	  bands are safeloaded into.

choice HAVEN_DAC_SOURCE
	prompt "What feeds the ADAU1860 DAC"
	default HAVEN_DAC_SOURCE_FDSP

config HAVEN_DAC_SOURCE_FDSP
	bool "FastDSP channel 0 (mic -> 5 biquads -> limiter): normal operation"

config HAVEN_DAC_SOURCE_DMIC_DIRECT
	bool "DMIC0 straight to the DAC: first-power-on smoke test, no DSP"
	help
	  Routes the raw PDM microphone to the DAC (DAC_ROUTE0 = 71, per ADI's
	  Lark SDK route enum). Use once on a fresh board: if you hear the room
	  the mic, clocks, DAC and receiver all work and any later silence is a
	  FastDSP program/routing question, not hardware. No filters and no
	  limiter are in this path -- never wear the device in this mode.
config HAVEN_TONE_FULL_SCALE_DB
	int "LDL tone: commanded level_db that maps to 0 dBFS on the I2S link"
	range 0 120
	default 85
	help
	  Tone amplitude = 10^((level_db - this)/20) of full scale, so the
	  default puts the protocol's 85 dB ceiling at exactly 0 dBFS -- the
	  loudest the link can carry. This is a NOMINAL placeholder: the real
	  relationship between level_db and dB SPL at the eardrum has to be
	  measured on hardware (haven-app docs/calibration.md), after which
	  this constant -- or a per-frequency table replacing it -- gets the
	  measured value. Do not treat any dB number as physical until then.

choice HAVEN_TONE_ROUTE
	prompt "LDL tone: codec routing while a tone plays"
	default HAVEN_TONE_ROUTE_DAC_DIRECT
	help
	  See docs/tone-path.md.

config HAVEN_TONE_ROUTE_DAC_DIRECT
	bool "DAC fed from the I2S input; hear-through paused for the tone"
	help
	  Upstream OpenEarable's non-DSP playback route (DAC_ROUTE0 = I2S with
	  serial port 0 -> input ASRC 0). Known to make sound; guarantees the
	  tone is not shaped by the user's own notch filters, which an LDL test
	  requires. Costs hear-through for the duration of the tone.

config HAVEN_TONE_ROUTE_FDSP_MIX
	bool "DAC stays on the FastDSP; rely on the program's mixer slot (unverified)"
	help
	  Leaves DAC_ROUTE0 on FastDSP channel 0 and assumes upstream's
	  program mixes the I2S/ASRC path in at slot 8 after the biquads. Not
	  established -- for hardware experiments only.

endchoice

endmenu

source "Kconfig.zephyr"
